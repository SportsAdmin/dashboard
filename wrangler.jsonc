// Cloudflare Workers (static assets) config for the Vite SPA.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  // Must match the Worker name in the Cloudflare dashboard
  "name": "dashboard",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Output of `npm run build`
    "directory": "./dist",
    // Unknown paths (/returns, /pos/new, ...) serve index.html so the client router handles them
    "not_found_handling": "single-page-application"
  }
}
